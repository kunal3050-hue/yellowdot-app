# /opt/yd/backend.env — TEMPLATE (REVIEW ONLY)
# Copy to VPS as /opt/yd/backend.env, chmod 600, fill in real values.
# NEVER commit this file with real secrets.
#
# Verify after copy:
#   python3 -c "import json,os; json.loads(os.environ['FIREBASE_SERVICE_ACCOUNT'])"
#   (or: node -e "JSON.parse(process.env.FIREBASE_SERVICE_ACCOUNT)" — run from shell with env loaded)

# ── Identity ────────────────────────────────────────────────────────────────
NODE_ENV=production
APP_ENV=production
SCHOOL_ID=ydseawoods

# ── Network ─────────────────────────────────────────────────────────────────
# Must match the container port in deploy/docker-compose.yml (currently 8080 —
# verified against the live VPS 2026-07-07; docker-compose.yml publishes it as
# 127.0.0.1:4000:8080, and Caddy reverse-proxies api.kueboxs.com to that).
PORT=8080
# Comma-separated list of allowed CORS origins (no trailing slash).
# Include the custom domain AND the default Firebase Hosting URLs so
# the app works even before the custom domain is configured in Firebase.
# Replace <project-id> with your Firebase project ID (e.g. yellowdot-app).
CORS_ORIGIN=https://app.kueboxs.com,https://<project-id>.web.app,https://<project-id>.firebaseapp.com

# ── Firebase Admin credentials ──────────────────────────────────────────────
# The running container does NOT read this variable: docker-compose mounts
# /opt/yd/firebase-sa.json read-only at /secrets/firebase-sa.json and points
# GOOGLE_APPLICATION_CREDENTIALS at it. That file is the live credential.
#
# This variable remains as the fallback path for a setup without the mount.
# If you need to populate it, generate a fresh key from the Firebase Console
# (Project Settings → Service Accounts → Generate new private key); the old
# instruction to export it from the Railway Raw Editor is obsolete, as the
# backend no longer runs on Railway. Must be valid JSON (test with
# JSON.parse). Wrap in single quotes on the VPS to avoid shell expansion.
FIREBASE_SERVICE_ACCOUNT='PASTE_JSON_HERE'

# ── Trust proxy (REQUIRED for a correct CCTV audit log) ─────────────────────
# Which peer Express will believe X-Forwarded-For from. req.ip is written to
# the CCTV audit log — who viewed which child's camera — and to the auth route.
#
# Set this to the Docker bridge GATEWAY, not loopback. yd-caddy runs on the
# host network so it sees the real client IP and forwards it, but it proxies
# via 127.0.0.1:4000 → docker-proxy → the container, and docker-proxy
# re-originates the connection. The peer this process sees is therefore
# 172.17.0.1, so "loopback" would silently leave the audit log recording the
# proxy instead of the viewer.
#
# Confirm the current value if the bridge is ever recreated:
#   docker inspect yd-backend --format '{{range .NetworkSettings.Networks}}{{.Gateway}}{{end}}'
#
# Do NOT set this to `true`. That trusts X-Forwarded-For from any caller and
# lets clients forge their own audit-log IP.
TRUST_PROXY=172.17.0.1

# ── CCTV streaming ──────────────────────────────────────────────────────────
# Public URL that browser clients use for HLS/WebRTC. Unchanged from current setup.
CCTV_STREAM_ENGINE_URL=https://stream.kueboxs.com

# HMAC secret for stream tokens. Generate once, keep permanent:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# This does NOT have to match anything in MediaMTX. An earlier version of this
# comment said it "MUST match what MediaMTX auth-hook validates against", which
# is wrong and sent at least one investigation down a blind alley. MediaMTX
# verifies nothing itself: its mediamtx.yml sets
#
#   authMethod: http
#   authHTTPAddress: https://<api-host>/internal/cctv/auth
#
# so it delegates every decision to this backend, which issues AND verifies the
# token in the same process (services/streamSessionService.js). There is no
# second party holding a copy of this secret.
#
# Not setting it is not an outage. The signing key falls back
# CCTV_STREAM_TOKEN_SECRET -> CCTV_ENCRYPTION_KEY -> a per-boot random value.
# Set it anyway, for two reasons:
#
#   1. Key separation. Without it the fallback signs tokens with
#      CCTV_ENCRYPTION_KEY, which is also the AES-256-GCM key for camera
#      passwords at rest (services/cryptoService.js). One key, two primitives:
#      rotating it to re-key stream tokens would leave every stored camera
#      password undecryptable until scripts/encryptCameraPasswords.js re-runs,
#      and with CCTV_REQUIRE_ENCRYPTION=true camera saves fail closed in the
#      meantime. A dedicated secret decouples the two rotations.
#   2. Multi-instance. The last-resort per-boot random value is per-process, so
#      a token issued by one instance fails verification on another. Fine for a
#      single container; breaks silently the moment there are two.
#
# Rotating this one is cheap on its own: tokens have a 120-second TTL
# (TTL_SECONDS in services/streamSessionService.js), so the only effect is that
# anyone mid-stream reconnects within two minutes.
CCTV_STREAM_TOKEN_SECRET=GENERATE_AND_PASTE_HERE

# ── Build info (set by deploy script, not manually) ─────────────────────────
# These are auto-populated by the deploy script using git and date.
# Leave blank here — the deploy script writes them via --env-file or docker run -e.
# APP_COMMIT=
# APP_BRANCH=
# APP_BUILD_TIME=

# ── Deferred (do not set until encryption hardening phase) ──────────────────
# CCTV_ENCRYPTION_KEY=
# CCTV_REQUIRE_ENCRYPTION=
